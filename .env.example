# Server
PORT=8080
GIN_MODE=debug

# Database: "sqlite" or "postgres"
DB_DRIVER=sqlite
DB_DSN=data/pao_event.db
# For PostgreSQL:
# DB_DRIVER=postgres
# DB_DSN=host=localhost user=postgres password=postgres dbname=pao_event port=5432 sslmode=disable

# JWT
JWT_SECRET=change-me-to-a-random-secret

# Super admin passkey (unset = super admin login disabled). The admin passkey is set in Settings.
SUPER_ADMIN_PASSKEY=change-me
